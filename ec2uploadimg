# Options that configured the helper instance used by earlier versions to
# upload the image, or the boot kernel of para-virtual images. The image is
# now written to a snapshot with the EBS direct APIs, the options have no
# effect and are ignored.
DEPRECATED_OPTIONS = (
    ('akiID', '--boot-kernel'),
    ('amiID', '--ec2-ami'),
    ('channelTimeout', '--channel-timeout'),
    ('grub2', '--grub2'),
    ('instType', '--type'),
    ('privateKey', '--private-key-file'),
    ('runningID', '--instance-id'),
    ('securityGroupIds', '--security-group-ids'),
    ('sshName', '--ssh-key-pair'),
    ('sshTimeout', '--ssh-timeout'),
    ('sshUser', '--user'),
    ('useEnclave', '--use-enclave'),
    ('usePrivateIP', '--use-private-ip'),
    ('vpcSubnetId', '--vpc-subnet-id')
)

# Global variables
aborted = False
logger = None
uploader = None


# ----------------------------------------------------------------------------
def print_ex(logger, msg=None):
    """Prints information about the exception currently handled
    """
    exc_type, value, tb = sys.exc_info()
    logger.debug(value, exc_info=True)

    if msg:
        logger.info(msg)
    else:
        logger.info("{}: {}".format(exc_type.__name__, value))


# ----------------------------------------------------------------------------
def signal_handler(signum, frame):
    """Handle signals and clean up resources properly"""
    global aborted
    if aborted:
        # if it got already aborted before,
        # we kill the upload without proper clean up
        sys.exit(1)
    aborted = True
    if uploader:
        uploader.abort()
    if not uploader:
        # if there is no uploader there are no resources we need to
        # cleanup and we just exit
        sys.exit(1)


